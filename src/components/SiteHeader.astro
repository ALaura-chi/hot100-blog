---
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../lib/paths';
interface Props { active?: string }
const { active = '' } = Astro.props;
const links = [['首页','', 'home'], ['文章','posts/hot_100/', 'article'], ['分类','categories/', 'categories'], ['关于','about/', 'about']];
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={withBase()} aria-label="ALaura 算法笔记首页"><span class="brand-mark" aria-hidden="true">A</span><span>ALaura<span class="brand-detail"> · 算法笔记</span></span></a>
    <div class="header-actions">
      <nav id="header-links" class="header-links" aria-label="主导航">
        {links.map(([label,path,key]) => <a href={withBase(path)} class:list={[{selected: active===key}]} aria-current={active===key?'page':undefined}>{label}</a>)}
        <a href="https://github.com/ALaura-chi" target="_blank" rel="noopener noreferrer">GitHub <span class="external-arrow" aria-hidden="true">↗</span></a>
      </nav>
      <ThemeToggle />
      <button id="menu-toggle" class="icon-button menu-toggle" type="button" aria-label="展开导航菜单" aria-expanded="false" aria-controls="header-links"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
    </div>
  </div>
</header>
