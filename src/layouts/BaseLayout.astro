---
import '../styles/global.css';
import '../styles/drafts.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackgroundEffects from '../components/BackgroundEffects.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { withBase } from '../lib/paths';
interface Props { title: string; description?: string; active?: string; article?: boolean }
const { title, description='按分类整理 LeetCode Hot 100，在思考、代码和复盘之间，留下一点进步。', active, article=false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title} | ALaura 算法笔记</title><meta name="description" content={description}/>
    <meta name="theme-color" content="#0f6b42"/><meta name="color-scheme" content="light dark"/>
    <link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')}/>
    <meta property="og:title" content={`${title} | ALaura 算法笔记`}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/>
    <script is:inline>
      (()=>{let theme;try{theme=localStorage.getItem('hot100-theme')}catch{}document.documentElement.dataset.theme=theme==='light'||theme==='dark'?theme:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';})();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <BackgroundEffects /><ReadingProgress /><SiteHeader active={active}/>
    <main id="main-content" class:list={['page-shell',{ 'reader-shell': article }]}><slot /></main>
    <SiteFooter />
    <button id="back-to-top" class="back-to-top" type="button" aria-label="回到顶部" hidden>↑</button>
    <div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>
    <script>import '../scripts/reader';</script>
  </body>
</html>
